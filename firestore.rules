rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isGoogleAdmin() {
      return isSignedIn() &&
        (request.auth.token.email == 'mishra939rishu@gmail.com' ||
         request.auth.token.email == 'Mishra939rishu@gmail.com' ||
         (request.auth.token.email is string && request.auth.token.email.matches('(?i)^mishra939rishu@gmail\\.com$')));
    }

    function isAuthorizedPayload(data) {
      return isGoogleAdmin() || (data.adminKey is string && (data.adminKey == 'Password@123' || data.adminKey == 'rishu2026'));
    }

    function isValidArticle(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 1000 &&
             (data.content is map || data.content is string) &&
             data.category is string && data.category.size() <= 200;
    }

    function isValidCategory(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 200 &&
             data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 200;
    }

    function isValidMessage(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 150 &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
             data.message is string && data.message.size() >= 1 && data.message.size() <= 10000;
    }

    function isValidProfile(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 150 &&
             data.role is string && data.role.size() <= 200;
    }

    // Articles Collection (Public read, Admin create/update/delete)
    match /articles/{articleId} {
      allow get, list: if true;
      allow create: if isValidId(articleId) && isAuthorizedPayload(incoming()) && isValidArticle(incoming());
      allow update: if isValidId(articleId) && (
        (isAuthorizedPayload(incoming()) && isValidArticle(incoming())) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) && request.resource.data.likes is number)
      );
      allow delete: if isValidId(articleId) && (
        isGoogleAdmin() ||
        (existing().adminKey is string && (existing().adminKey == 'Password@123' || existing().adminKey == 'rishu2026')) ||
        (existing().authorEmail is string && existing().authorEmail == 'mishra939rishu@gmail.com')
      );
    }

    // Categories Collection (Public read, Admin create/update/delete)
    match /categories/{categoryId} {
      allow get, list: if true;
      allow create, update: if isValidId(categoryId) && isAuthorizedPayload(incoming()) && isValidCategory(incoming());
      allow delete: if isValidId(categoryId) && (
        isGoogleAdmin() ||
        (existing().adminKey is string && (existing().adminKey == 'Password@123' || existing().adminKey == 'rishu2026'))
      );
    }

    // Contact Messages Collection (Public create, Admin read/manage)
    match /messages/{messageId} {
      allow create: if isValidId(messageId) && isValidMessage(incoming());
      allow list: if true;
      allow get, update, delete: if isValidId(messageId);
    }

    // Author Profile Collection (Public read, Admin write)
    match /profile/{profileId} {
      allow get, list: if true;
      allow write: if isValidId(profileId) && isAuthorizedPayload(incoming()) && isValidProfile(incoming());
    }
  }
}
