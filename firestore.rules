rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email.lower() == 'mishra939rishu@gmail.com';
    }

    function isValidArticle(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() >= 2 && data.title.size() <= 300 &&
             (data.content is map || data.content is string) &&
             data.category is string && data.category.size() <= 100 &&
             data.authorEmail.lower() == 'mishra939rishu@gmail.com';
    }

    function isValidCategory(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
             data.slug is string && data.slug.size() >= 2 && data.slug.size() <= 120;
    }

    function isValidMessage(data) {
      return data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
             data.email is string && data.email.size() >= 5 && data.email.size() <= 150 &&
             data.message is string && data.message.size() >= 3 && data.message.size() <= 5000;
    }

    function isValidProfile(data) {
      return data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
             data.role is string && data.role.size() <= 150;
    }

    // Articles Collection (Public read, Admin-only create/update/delete)
    match /articles/{articleId} {
      allow get, list: if true;
      allow create: if isValidId(articleId) && isAdmin() && isValidArticle(incoming());
      allow update: if isValidId(articleId) && (
        (isAdmin() && isValidArticle(incoming())) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) && request.resource.data.likes is number)
      );
      allow delete: if isValidId(articleId) && isAdmin();
    }

    // Categories Collection (Public read, Admin-only create/update/delete)
    match /categories/{categoryId} {
      allow get, list: if true;
      allow create, update: if isValidId(categoryId) && isAdmin() && isValidCategory(incoming());
      allow delete: if isValidId(categoryId) && isAdmin();
    }

    // Contact Messages Collection (Public create, Admin-only read/manage)
    match /messages/{messageId} {
      allow create: if isValidId(messageId) && isValidMessage(incoming());
      allow get, list, update, delete: if isValidId(messageId) && isAdmin();
    }

    // Author Profile Collection (Public read, Admin-only write)
    match /profile/{profileId} {
      allow get, list: if true;
      allow write: if isValidId(profileId) && isAdmin() && isValidProfile(incoming());
    }
  }
}
